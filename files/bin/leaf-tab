set -euo pipefail

if [ $# -lt 1 ] || [ -z "$1" ]; then
  echo "leaf-tab: file path is required" >&2
  exit 1
fi

target_path="$1"
if [ ! -e "$target_path" ]; then
  echo "leaf-tab: file not found: $target_path" >&2
  exit 1
fi

leaf_exe=$(command -v leaf || true)
if [ -z "$leaf_exe" ]; then
  echo "leaf-tab: leaf command not found" >&2
  exit 1
fi

abs_path=$(realpath "$target_path")
repo_root=$(git rev-parse --show-toplevel 2>/dev/null || true)

if [ -n "$repo_root" ] && { [ "$abs_path" = "$repo_root" ] || [[ "$abs_path" == "$repo_root/"* ]]; }; then
  repo_name=$(basename "$repo_root")
  rel_path=$(realpath --relative-to="$repo_root" "$abs_path")
  tab_name="leaf:$repo_name/$rel_path"
  tab_cwd="$repo_root"
else
  file_name=$(basename "$abs_path")
  tab_name="leaf:$file_name"
  tab_cwd=$(dirname "$abs_path")
fi

if zellij action list-tabs --json \
  | jq -e --arg name "$tab_name" 'any(.[]; .name == $name)' >/dev/null; then
  exec zellij action go-to-tab-name "$tab_name"
fi

exec zellij action new-tab \
  --name "$tab_name" \
  --cwd "$tab_cwd" \
  -- "$leaf_exe" "$abs_path"
